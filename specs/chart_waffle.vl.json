{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How much of Australia was in drought, 2017–2019?",
    "subtitle": ["Each square is 1% of Australia's land area,", "coloured by its 2017–2019 rainfall as a % of normal."],
    "anchor": "start", "fontSize": 18, "subtitleFontSize": 12, "offset": 12
  },
  "width": 260,
  "height": 260,
  "data": {
    "url": "data/waffle_2017_2019.csv",
    "format": {"type": "csv", "parse": {"col": "number", "row": "number", "pct_of_land": "number"}}
  },
  "mark": {"type": "rect", "stroke": "#f6f3ec", "strokeWidth": 2},
  "encoding": {
    "x": {"field": "col", "type": "ordinal", "axis": null},
    "y": {"field": "row", "type": "ordinal", "axis": null},
    "color": {
      "field": "band",
      "type": "nominal",
      "title": "Rainfall (% of normal)",
      "scale": {
        "domain": ["Under 60%", "60–80%", "80–95%", "95–105%", "105–120%", "120% or more"],
        "range": ["#8c510a", "#b8742a", "#d9a24e", "#f5d93f", "#56aa9d", "#21716a"]
      },
      "legend": {"orient": "right", "symbolType": "square", "symbolSize": 200, "symbolStrokeColor": "#b8ae9c"}
    },
    "tooltip": [
      {"field": "band", "type": "nominal", "title": "Rainfall"},
      {"field": "pct_of_land", "type": "quantitative", "title": "% of Australia's land", "format": ".1f"}
    ]
  },
  "config": {"view": {"stroke": null}}
}