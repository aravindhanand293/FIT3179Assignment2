{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Some states swing much harder between wet and dry",
    "subtitle": [
      "Each dot is one year since 1900. Dots left of the dashed line were dry years (under 80% of normal).",
      "Hover over a dot to light up that same year in every state: was the drought national or regional?"
    ],
    "anchor": "start", "fontSize": 18, "subtitleFontSize": 12, "offset": 12
  },
  "width": 760,
  "height": {"step": 44},
  "data": {
    "url": "data/state_annual.csv",
    "format": {"type": "csv", "parse": {"year": "number", "rain_pct": "number"}}
  },
  "transform": [
    {"calculate": "((datum.year * 9301 + 49297) % 233280) / 233280", "as": "jitter"},
    {"calculate": "datum.rain_pct < 80 ? 'Dry year (under 80%)' : datum.rain_pct <= 120 ? 'Near normal (80–120%)' : 'Wet year (over 120%)'", "as": "year_type"}
  ],
  "encoding": {
    "x": {
      "field": "rain_pct", "type": "quantitative", "title": "Rainfall (% of normal)",
      "scale": {"domain": [20, 210], "clamp": true}
    },
    "y": {
      "field": "state", "type": "nominal", "title": null,
      "sort": ["Northern Territory", "Queensland", "Western Australia", "South Australia", "New South Wales", "Victoria", "Tasmania"],
      "axis": {"domain": false, "ticks": false, "grid": false}
    },
    "yOffset": {"field": "jitter", "type": "quantitative", "scale": {"domain": [-0.6, 1.6]}}
  },
  "layer": [
    {
      "data": {"values": [{"x": 80}]},
      "mark": {"type": "rule", "strokeDash": [4, 3], "color": "#5e2a0c"},
      "encoding": {"x": {"field": "x", "type": "quantitative"}, "y": null, "yOffset": null}
    },
    {
      "data": {"values": [{"x": 100}]},
      "mark": {"type": "rule", "color": "#777"},
      "encoding": {"x": {"field": "x", "type": "quantitative"}, "y": null, "yOffset": null}
    },
    {
      "params": [
        {
          "name": "hover_year",
          "select": {"type": "point", "fields": ["year"], "on": "mouseover", "clear": "mouseout", "nearest": true}
        }
      ],
      "mark": {"type": "circle", "size": 26},
      "encoding": {
        "color": {
          "field": "year_type", "type": "nominal", "title": null,
          "scale": {
            "domain": ["Dry year (under 80%)", "Near normal (80–120%)", "Wet year (over 120%)"],
            "range": ["#a6611a", "#c9c3b8", "#35978f"]
          },
          "legend": {"orient": "top", "direction": "horizontal"}
        },
        "opacity": {
          "condition": {"param": "hover_year", "empty": true, "value": 0.8},
          "value": 0.15
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
          {"field": "rain_pct", "type": "quantitative", "title": "Rainfall (% of normal)", "format": ".0f"}
        ]
      }
    },
    {
      "transform": [{"filter": {"param": "hover_year", "empty": false}}],
      "mark": {"type": "circle", "size": 120, "opacity": 1, "stroke": "#2b1a0e", "strokeWidth": 1.5},
      "encoding": {
        "color": {"field": "year_type", "type": "nominal"}
      }
    },
    {
      "transform": [
        {"filter": {"param": "hover_year", "empty": false}},
        {"calculate": "format(datum.rain_pct, '.0f') + '%'", "as": "label"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 10, "fontSize": 11, "fontWeight": "bold", "color": "#2b1a0e"},
      "encoding": {"text": {"field": "label"}}
    },
    {
      "transform": [
        {"filter": {"param": "hover_year", "empty": false}},
        {"calculate": "datum.rain_pct < 80 ? 1 : 0", "as": "dry"},
        {"aggregate": [{"op": "sum", "field": "dry", "as": "dry_states"}, {"op": "max", "field": "year", "as": "year"}]},
        {"calculate": "datum.year + ': a dry year in ' + datum.dry_states + ' of 7 states'", "as": "note"}
      ],
      "mark": {"type": "text", "align": "right", "baseline": "bottom", "fontSize": 13, "fontStyle": "italic", "fontWeight": "bold", "color": "#5e2a0c"},
      "encoding": {
        "x": {"value": 760},
        "y": {"value": -6},
        "yOffset": null,
        "text": {"field": "note"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}